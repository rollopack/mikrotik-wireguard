# ──────────────────────────────────────────────────────
# IP Access Restriction — Template
# ──────────────────────────────────────────────────────
# How to use:
#   1. Copy this file to .htaccess (or rename it):
#      cp .htaccess.example .htaccess
#   2. Uncomment the Require ip line(s) for your network(s)
#      by removing the leading "# "
#   3. Apache requires AllowOverride All (or at minimum
#      AllowOverride AuthConfig) in the VirtualHost config
#      for .htaccess files to work.
#   4. Add more Require ip lines for additional subnets
#      (e.g., a corporate VPN).
#
# NOTE: In Apache 2.4+ just list Require ip directives.
# There's no need for <RequireAll> — Apache denies all
# by default, and Require ip creates exceptions.
# Incorrect: <RequireAll> Require all denied; Require ip ... </RequireAll>
# Correct:   Require ip <your_network>
# ──────────────────────────────────────────────────────
Require ip 192.168.111
# Require ip 10.0.0.0/8
# Require ip 172.16.0.0/12

# ──────────────────────────────────────────────────────
# Force Authorization header forwarding to PHP-FPM/FastCGI
# (Apache di default rimuove l'header Authorization nelle richieste a script PHP)
# Aggiungere questa riga anche nel .htaccess LIVE (non solo nel template).
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# ──────────────────────────────────────────────────────
# Block direct access to dotfiles (.admin-hash, .api-token, .htaccess)
# ──────────────────────────────────────────────────────
# REQUIRED if the document root is this project folder:
# without this, a browser could download .api-token (the API
# token) or .admin-hash as plain text.
# After enabling, verify with:  https://your-host/.api-token  -> 403
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ──────────────────────────────────────────────────────
# Compression and caching for static assets
# ──────────────────────────────────────────────────────
# CSS/JS URLs on the dashboard carry a version query parameter. These assets
# can therefore be cached for a year; PHP endpoints set their own no-store
# headers and are not covered by these rules.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
